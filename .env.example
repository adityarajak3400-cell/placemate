# PlaceMate — canonical environment variable list (docs/ARCHITECTURE.md §9).
# Copy values into server/.env and client/.env.local — never commit real values (docs/SECURITY.md).

# ── server/.env ────────────────────────────────────────────────
# Supabase Postgres connection string (TASK-002)
DATABASE_URL=
# Signs auth tokens — 32+ random chars
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
# CORS allowlist — exactly one origin
CLIENT_ORIGIN=http://localhost:3000
# Resume storage (TASK-026)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Admin account for `prisma db seed` (TASK-054)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── client/.env.local ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
